FROM python:3.14-slim
WORKDIR /app
COPY pyproject.toml README.md requirements-runtime.lock ./
COPY python/ ./python/
RUN pip install --no-cache-dir pip==26.2.1 && pip install --no-cache-dir -r requirements-runtime.lock && pip install --no-cache-dir --no-deps . && useradd --uid 10001 --create-home neurosim && mkdir /data && chown neurosim /data
USER neurosim
ENV NEUROSIM_DB=/data/experiments.db
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"
CMD ["neurosim-serve"]
